  <PropertyPackages>
    <PropertyPackage>
      <ID>PP-2525e301-72cb-46b3-a162-d556e9cb5db0</ID>
      <Type>DWSIM.Thermodynamics.PropertyPackages.RaoultPropertyPackage</Type>
      <ComponentName>Raoult's Law</ComponentName>
      <ComponentDescription></ComponentDescription>
      <Tag>Isothermal liquid carrier; empirical Laliberte density override</Tag>
      <UseHenryConstants>true</UseHenryConstants>
      <AutoEstimateMissingNRTLUNIQUACParameters>true</AutoEstimateMissingNRTLUNIQUACParameters>
      <UseImmiscibleListForLiquid2InitialEstimates>true</UseImmiscibleListForLiquid2InitialEstimates>
      <SingleCompoundCheckThreshold>0.99999</SingleCompoundCheckThreshold>
      <OverrideKvalFugCoeff>false</OverrideKvalFugCoeff>
      <OverrideEnthalpyCalculation>false</OverrideEnthalpyCalculation>
      <OverrideEntropyCalculation>false</OverrideEntropyCalculation>
      <LiquidDensityCalculationMode_Subcritical>Rackett_and_ExpData</LiquidDensityCalculationMode_Subcritical>
      <LiquidDensityCalculationMode_Supercritical>Rackett_and_ExpData</LiquidDensityCalculationMode_Supercritical>
      <LiquidDensity_CorrectExpDataForPressure>true</LiquidDensity_CorrectExpDataForPressure>
      <LiquidDensity_UsePenelouxVolumeTranslation>true</LiquidDensity_UsePenelouxVolumeTranslation>
      <LiquidViscosityCalculationMode_Subcritical>ExpData</LiquidViscosityCalculationMode_Subcritical>
      <LiquidViscosityCalculationMode_Supercritical>Letsou_Stiel</LiquidViscosityCalculationMode_Supercritical>
      <LiquidViscosity_CorrectExpDataForPressure>true</LiquidViscosity_CorrectExpDataForPressure>
      <LiquidViscosity_MixingRule>MoleAverage</LiquidViscosity_MixingRule>
      <VaporPhaseFugacityCalculationMode>Ideal</VaporPhaseFugacityCalculationMode>
      <SolidPhaseFugacityCalculationMethod>FromLiquidFugacity</SolidPhaseFugacityCalculationMethod>
      <SolidPhaseFugacity_UseIdealLiquidPhaseFugacity>false</SolidPhaseFugacity_UseIdealLiquidPhaseFugacity>
      <SolidPhaseEnthalpy_UsesCp>false</SolidPhaseEnthalpy_UsesCp>
      <EnthalpyEntropyCpCvCalculationMode>Ideal</EnthalpyEntropyCpCvCalculationMode>
      <LiquidEnthalpyEntropyCpCvCalculationMode_EOS>EOS</LiquidEnthalpyEntropyCpCvCalculationMode_EOS>
      <LiquidFugacity_UsePoyntingCorrectionFactor>true</LiquidFugacity_UsePoyntingCorrectionFactor>
      <ActivityCoefficientModels_IgnoreMissingInteractionParameters>false</ActivityCoefficientModels_IgnoreMissingInteractionParameters>
      <IgnoreVaporFractionLimit>false</IgnoreVaporFractionLimit>
      <IgnoreSalinityLimit>false</IgnoreSalinityLimit>
      <CalculateAdditionalMaterialStreamProperties>true</CalculateAdditionalMaterialStreamProperties>
      <FlashCalculationApproach>NestedLoops</FlashCalculationApproach>
      <DisplayMissingCompoundPropertiesWarning>false</DisplayMissingCompoundPropertiesWarning>
      <ForcedSolids>[]</ForcedSolids>
      <PropertyOverrides>{
  "Mixture/density": "PARAMS = {\u0027Nitric acid\u0027: {\u0027CAS\u0027: \u00277697-37-2\u0027, \u0027density\u0027: [0.272070788161643, -0.399605969016834, -2.33691977745914, 0.0066211238427596, -3089.01794099058], \u0027viscosity\u0027: [8.22640393251e-05, -1.39718811419252, 0.11961884204502, -0.0199197916008091, -1.44481163970687, 0.906940098315068], \u0027density_range\u0027: [-10.0, 95.0, 0.7011], \u0027viscosity_range\u0027: [4.0, 25.0, 0.308600425720215]}, \u0027Hydrogen chloride\u0027: {\u0027CAS\u0027: \u00277647-01-0\u0027, \u0027density\u0027: [0.0002838722604829, 0.0039494695716988, 2.85020047681807, -0.0157747012568046, -3766.20868665006], \u0027viscosity\u0027: [10.3259686042518, 1.71378270014506, 1.48613181961032, 0.0012790744923139, 23.7644188926256, 2.1827423115052], \u0027density_range\u0027: [5.0, 98.8200000000001, 0.375698567711746], \u0027viscosity_range\u0027: [10.0, 42.5, 0.36]}, \u0027Ammonia\u0027: {\u0027CAS\u0027: \u00277664-41-7\u0027, \u0027density\u0027: [0.0637631725924523, 0.0681799828976475, 1.23759952767397, -0.0059985249372147, -3078.57767189507], \u0027viscosity\u0027: [214.093149693271, 8.02413293476943, 6.62645825743232, 0.0057942959530428, 255.273038265555, 0.243086396113273], \u0027density_range\u0027: [20.0, 140.65, 0.521892056235873], \u0027viscosity_range\u0027: [19.85, 39.85, 0.339554069991558]}, \u0027Ammonium Chloride\u0027: {\u0027CAS\u0027: \u002712125-02-9\u0027, \u0027density\u0027: [16.8882196383907, 318.560293047784, 5.08655606958672, -0.0150616503055142, -1769.12237165588], \u0027viscosity\u0027: [12.3958070582055, 1.50390805858088, -1.77559495076665, 0.234706870177963, -2.75914543946026, 2.84081895215159], \u0027density_range\u0027: [12.5, 100.0, 0.4], \u0027viscosity_range\u0027: [10.0, 73.5, 0.324324324324324]}}\n\u0022\u0022\u0022Isothermal aqueous analytical-component properties (Python 2/3 compatible).\n\nLaliberte 2009, doi:10.1021/je8008123. PARAMS is injected into native scripts.\nNo acid speciation, VLE, retention, or mixing-enthalpy model is implied.\n\u0022\u0022\u0022\nfrom math import exp,log,pi,sqrt\nCOMPONENTS=[\u0027Water\u0027,\u0027Nitric acid\u0027,\u0027Hydrogen chloride\u0027,\u0027Ammonia\u0027,\u0027Ammonium Chloride\u0027]\nMW=[18.01528,63.01284,36.46094,17.03052,53.49146] # g/mol; last = HCl + NH3\n\ndef liquid_density(masses,T=298.15):\n    total=sum(masses)\n    if total\u003c=0: raise ValueError(\u0027A liquid stream needs positive mass\u0027)\n    w=[x/total for x in masses]; ww=w[0]; t=T-273.15\n    rho_w=(((((-2.8054253e-10*t+1.0556302e-7)*t-4.6170461e-5)*t-.0079870401)*t+16.945176)*t+999.83952)/(1+.01687985*t)\n    invrho=ww/rho_w\n    for i,name in enumerate(COMPONENTS[1:],1):\n        if w[i]\u003c=0:continue\n        p=PARAMS[name]; low,high,wmax=p[\u0027density_range\u0027]\n        if t\u003clow-1e-8 or t\u003ehigh+1e-8 or w[i]\u003ewmax+1e-8:raise ValueError(\u0027Density correlation outside domain: \u0027+name)\n        c0,c1,c2,c3,c4=p[\u0027density\u0027]\n        rho=((c0*(1-ww)+c1)*exp(1e-6*(t+c4)**2))/((1-ww)+c2+c3*t)\n        invrho+=w[i]/rho\n    return 1/invrho\n\ndef liquid_viscosity(masses,T=298.15):\n    total=sum(masses);w=[x/total for x in masses];ww=w[0];t=T-273.15\n    mu_w=(t+246)/((.05594*t+5.2842)*t+137.37) # mPa s\n    log_mu=ww*log(mu_w)\n    for i,name in enumerate(COMPONENTS[1:],1):\n        if w[i]\u003c=0:continue\n        p=PARAMS[name];low,high,wmax=p[\u0027viscosity_range\u0027]\n        if t\u003clow-1e-8 or t\u003ehigh+1e-8 or w[i]\u003ewmax+1e-8:raise ValueError(\u0027Viscosity correlation outside domain: \u0027+name)\n        v1,v2,v3,v4,v5,v6=p[\u0027viscosity\u0027]\n        # Evaluate logarithm directly; pure-water branch avoids negative powers at zero.\n        log_mu+=w[i]*((v1*(1-ww)**v2+v3)/(v4*t+1)-log(v5*(1-ww)**v6+1))\n    return exp(log_mu)*1e-3\n\ndef liquid_volume(masses):\n    return sum(masses)/liquid_density(masses)*1e6 # kg / kg m-3 -\u003e mL\n\ndef solution(volume_mL, concentrations=None):\n    \u0022\u0022\u0022Masses kg from final solution volume and analytical molarities at 25 C.\u0022\u0022\u0022\n    if concentrations is None: concentrations={}\n    masses=[0.0]*5\n    for name,C in concentrations.items():\n        i=COMPONENTS.index(name);masses[i]=C*volume_mL/1000*MW[i]/1000\n    solute=sum(masses)\n    # Bracket water mass inside each binary correlation\u0027s domain.\n    min_water=1e-12\n    for i,name in enumerate(COMPONENTS[1:],1):\n        if masses[i]\u003e0:min_water=max(min_water,masses[i]/PARAMS[name][\u0027density_range\u0027][2]-solute)\n    lo=max(min_water,1e-12);hi=max(volume_mL*.002,lo*2)\n    masses[0]=lo\n    if liquid_volume(masses)\u003evolume_mL+1e-8:raise ValueError(\u0027Requested concentration exceeds validated domain\u0027)\n    for k in range(80):\n        masses[0]=(lo+hi)/2\n        if liquid_volume(masses)\u003evolume_mL:hi=masses[0]\n        else:lo=masses[0]\n    masses[0]=(lo+hi)/2\n    return masses\n\ndef mix_mass(*vectors):\n    return [sum(v[i] for v in vectors) for i in range(5)]\n\ndef subtract_mass(a,b):\n    out=[a[i]-b[i] for i in range(5)]\n    if min(out)\u003c-1e-12:raise ValueError(\u0027Specified collection cut exceeds available component mass\u0027)\n    return [max(0,x) for x in out]\n\ndef condition(feed,target_M=.05,base_M=1.):\n    \u0022\u0022\u0022Scenario NH3(aq) addition to analytical free-HCl target; no pH prediction.\u0022\u0022\u0022\n    acid=feed[2]/(MW[2]/1000)\n    if feed[1]\u003e1e-12 or feed[3]\u003e1e-12:raise ValueError(\u0027Conditioner boundary assumes HCl carryover only\u0027)\n    def at(v):\n        base=solution(v,{\u0027Ammonia\u0027:base_M}) if v\u003e0 else [0.]*5\n        out=mix_mass(feed,base)\n        n=min(acid,base[3]/(MW[3]/1000))\n        out[2]-=n*MW[2]/1000;out[3]-=n*MW[3]/1000\n        out[4]+=n*(MW[2]+MW[3])/1000\n        return base,out,(acid-n)/(liquid_volume(out)/1000)\n    lo=0.;hi=acid/base_M*1000\n    if at(0)[2]\u003ctarget_M-1e-10:raise ValueError(\u0027Initial acid below specified target\u0027)\n    for k in range(65):\n        mid=(lo+hi)/2\n        if at(mid)[2]\u003etarget_M:lo=mid\n        else:hi=mid\n    base,out,c=at((lo+hi)/2)\n    return base,out,c\n\ndef ergun(masses,flow_mL_min,bed_mL,diameter_mm,particle_um=100.,voidage=.4):\n    \u0022\u0022\u0022Clean spherical fixed-bed screening; no resin compression/dispersion claim.\u0022\u0022\u0022\n    rho=liquid_density(masses);mu=liquid_viscosity(masses)\n    area=pi*(diameter_mm*.001)**2/4\n    length=bed_mL*1e-6/area;u=flow_mL_min*1e-6/60/area;dp=particle_um*1e-6;e=voidage\n    dP=length*(150*mu*(1-e)**2*u/(e**3*dp**2)+1.75*rho*(1-e)*u*u/(e**3*dp))\n    return dP\n\ndef ph_recovery(ph):\n    if ph\u003c1.5 or ph\u003e2.5:raise ValueError(\u0027Measured pH interpolation restricted to 1.5--2.5\u0027)\n    if ph\u003c=2:return .95+.06*(ph-1.5)\n    return .98-.64*(ph-2)\n\npropval=liquid_density([float(matstr.Phases[0].Compounds[n].MassFraction) for n in COMPONENTS],float(matstr.GetTemperature()))\n",
  "OverallLiquid/density": "PARAMS = {\u0027Nitric acid\u0027: {\u0027CAS\u0027: \u00277697-37-2\u0027, \u0027density\u0027: [0.272070788161643, -0.399605969016834, -2.33691977745914, 0.0066211238427596, -3089.01794099058], \u0027viscosity\u0027: [8.22640393251e-05, -1.39718811419252, 0.11961884204502, -0.0199197916008091, -1.44481163970687, 0.906940098315068], \u0027density_range\u0027: [-10.0, 95.0, 0.7011], \u0027viscosity_range\u0027: [4.0, 25.0, 0.308600425720215]}, \u0027Hydrogen chloride\u0027: {\u0027CAS\u0027: \u00277647-01-0\u0027, \u0027density\u0027: [0.0002838722604829, 0.0039494695716988, 2.85020047681807, -0.0157747012568046, -3766.20868665006], \u0027viscosity\u0027: [10.3259686042518, 1.71378270014506, 1.48613181961032, 0.0012790744923139, 23.7644188926256, 2.1827423115052], \u0027density_range\u0027: [5.0, 98.8200000000001, 0.375698567711746], \u0027viscosity_range\u0027: [10.0, 42.5, 0.36]}, \u0027Ammonia\u0027: {\u0027CAS\u0027: \u00277664-41-7\u0027, \u0027density\u0027: [0.0637631725924523, 0.0681799828976475, 1.23759952767397, -0.0059985249372147, -3078.57767189507], \u0027viscosity\u0027: [214.093149693271, 8.02413293476943, 6.62645825743232, 0.0057942959530428, 255.273038265555, 0.243086396113273], \u0027density_range\u0027: [20.0, 140.65, 0.521892056235873], \u0027viscosity_range\u0027: [19.85, 39.85, 0.339554069991558]}, \u0027Ammonium Chloride\u0027: {\u0027CAS\u0027: \u002712125-02-9\u0027, \u0027density\u0027: [16.8882196383907, 318.560293047784, 5.08655606958672, -0.0150616503055142, -1769.12237165588], \u0027viscosity\u0027: [12.3958070582055, 1.50390805858088, -1.77559495076665, 0.234706870177963, -2.75914543946026, 2.84081895215159], \u0027density_range\u0027: [12.5, 100.0, 0.4], \u0027viscosity_range\u0027: [10.0, 73.5, 0.324324324324324]}}\n\u0022\u0022\u0022Isothermal aqueous analytical-component properties (Python 2/3 compatible).\n\nLaliberte 2009, doi:10.1021/je8008123. PARAMS is injected into native scripts.\nNo acid speciation, VLE, retention, or mixing-enthalpy model is implied.\n\u0022\u0022\u0022\nfrom math import exp,log,pi,sqrt\nCOMPONENTS=[\u0027Water\u0027,\u0027Nitric acid\u0027,\u0027Hydrogen chloride\u0027,\u0027Ammonia\u0027,\u0027Ammonium Chloride\u0027]\nMW=[18.01528,63.01284,36.46094,17.03052,53.49146] # g/mol; last = HCl + NH3\n\ndef liquid_density(masses,T=298.15):\n    total=sum(masses)\n    if total\u003c=0: raise ValueError(\u0027A liquid stream needs positive mass\u0027)\n    w=[x/total for x in masses]; ww=w[0]; t=T-273.15\n    rho_w=(((((-2.8054253e-10*t+1.0556302e-7)*t-4.6170461e-5)*t-.0079870401)*t+16.945176)*t+999.83952)/(1+.01687985*t)\n    invrho=ww/rho_w\n    for i,name in enumerate(COMPONENTS[1:],1):\n        if w[i]\u003c=0:continue\n        p=PARAMS[name]; low,high,wmax=p[\u0027density_range\u0027]\n        if t\u003clow-1e-8 or t\u003ehigh+1e-8 or w[i]\u003ewmax+1e-8:raise ValueError(\u0027Density correlation outside domain: \u0027+name)\n        c0,c1,c2,c3,c4=p[\u0027density\u0027]\n        rho=((c0*(1-ww)+c1)*exp(1e-6*(t+c4)**2))/((1-ww)+c2+c3*t)\n        invrho+=w[i]/rho\n    return 1/invrho\n\ndef liquid_viscosity(masses,T=298.15):\n    total=sum(masses);w=[x/total for x in masses];ww=w[0];t=T-273.15\n    mu_w=(t+246)/((.05594*t+5.2842)*t+137.37) # mPa s\n    log_mu=ww*log(mu_w)\n    for i,name in enumerate(COMPONENTS[1:],1):\n        if w[i]\u003c=0:continue\n        p=PARAMS[name];low,high,wmax=p[\u0027viscosity_range\u0027]\n        if t\u003clow-1e-8 or t\u003ehigh+1e-8 or w[i]\u003ewmax+1e-8:raise ValueError(\u0027Viscosity correlation outside domain: \u0027+name)\n        v1,v2,v3,v4,v5,v6=p[\u0027viscosity\u0027]\n        # Evaluate logarithm directly; pure-water branch avoids negative powers at zero.\n        log_mu+=w[i]*((v1*(1-ww)**v2+v3)/(v4*t+1)-log(v5*(1-ww)**v6+1))\n    return exp(log_mu)*1e-3\n\ndef liquid_volume(masses):\n    return sum(masses)/liquid_density(masses)*1e6 # kg / kg m-3 -\u003e mL\n\ndef solution(volume_mL, concentrations=None):\n    \u0022\u0022\u0022Masses kg from final solution volume and analytical molarities at 25 C.\u0022\u0022\u0022\n    if concentrations is None: concentrations={}\n    masses=[0.0]*5\n    for name,C in concentrations.items():\n        i=COMPONENTS.index(name);masses[i]=C*volume_mL/1000*MW[i]/1000\n    solute=sum(masses)\n    # Bracket water mass inside each binary correlation\u0027s domain.\n    min_water=1e-12\n    for i,name in enumerate(COMPONENTS[1:],1):\n        if masses[i]\u003e0:min_water=max(min_water,masses[i]/PARAMS[name][\u0027density_range\u0027][2]-solute)\n    lo=max(min_water,1e-12);hi=max(volume_mL*.002,lo*2)\n    masses[0]=lo\n    if liquid_volume(masses)\u003evolume_mL+1e-8:raise ValueError(\u0027Requested concentration exceeds validated domain\u0027)\n    for k in range(80):\n        masses[0]=(lo+hi)/2\n        if liquid_volume(masses)\u003evolume_mL:hi=masses[0]\n        else:lo=masses[0]\n    masses[0]=(lo+hi)/2\n    return masses\n\ndef mix_mass(*vectors):\n    return [sum(v[i] for v in vectors) for i in range(5)]\n\ndef subtract_mass(a,b):\n    out=[a[i]-b[i] for i in range(5)]\n    if min(out)\u003c-1e-12:raise ValueError(\u0027Specified collection cut exceeds available component mass\u0027)\n    return [max(0,x) for x in out]\n\ndef condition(feed,target_M=.05,base_M=1.):\n    \u0022\u0022\u0022Scenario NH3(aq) addition to analytical free-HCl target; no pH prediction.\u0022\u0022\u0022\n    acid=feed[2]/(MW[2]/1000)\n    if feed[1]\u003e1e-12 or feed[3]\u003e1e-12:raise ValueError(\u0027Conditioner boundary assumes HCl carryover only\u0027)\n    def at(v):\n        base=solution(v,{\u0027Ammonia\u0027:base_M}) if v\u003e0 else [0.]*5\n        out=mix_mass(feed,base)\n        n=min(acid,base[3]/(MW[3]/1000))\n        out[2]-=n*MW[2]/1000;out[3]-=n*MW[3]/1000\n        out[4]+=n*(MW[2]+MW[3])/1000\n        return base,out,(acid-n)/(liquid_volume(out)/1000)\n    lo=0.;hi=acid/base_M*1000\n    if at(0)[2]\u003ctarget_M-1e-10:raise ValueError(\u0027Initial acid below specified target\u0027)\n    for k in range(65):\n        mid=(lo+hi)/2\n        if at(mid)[2]\u003etarget_M:lo=mid\n        else:hi=mid\n    base,out,c=at((lo+hi)/2)\n    return base,out,c\n\ndef ergun(masses,flow_mL_min,bed_mL,diameter_mm,particle_um=100.,voidage=.4):\n    \u0022\u0022\u0022Clean spherical fixed-bed screening; no resin compression/dispersion claim.\u0022\u0022\u0022\n    rho=liquid_density(masses);mu=liquid_viscosity(masses)\n    area=pi*(diameter_mm*.001)**2/4\n    length=bed_mL*1e-6/area;u=flow_mL_min*1e-6/60/area;dp=particle_um*1e-6;e=voidage\n    dP=length*(150*mu*(1-e)**2*u/(e**3*dp**2)+1.75*rho*(1-e)*u*u/(e**3*dp))\n    return dP\n\ndef ph_recovery(ph):\n    if ph\u003c1.5 or ph\u003e2.5:raise ValueError(\u0027Measured pH interpolation restricted to 1.5--2.5\u0027)\n    if ph\u003c=2:return .95+.06*(ph-1.5)\n    return .98-.64*(ph-2)\n\npropval=liquid_density([float(matstr.Phases[0].Compounds[n].MassFraction) for n in COMPONENTS],float(matstr.GetTemperature()))\n",
  "Liquid1/density": "PARAMS = {\u0027Nitric acid\u0027: {\u0027CAS\u0027: \u00277697-37-2\u0027, \u0027density\u0027: [0.272070788161643, -0.399605969016834, -2.33691977745914, 0.0066211238427596, -3089.01794099058], \u0027viscosity\u0027: [8.22640393251e-05, -1.39718811419252, 0.11961884204502, -0.0199197916008091, -1.44481163970687, 0.906940098315068], \u0027density_range\u0027: [-10.0, 95.0, 0.7011], \u0027viscosity_range\u0027: [4.0, 25.0, 0.308600425720215]}, \u0027Hydrogen chloride\u0027: {\u0027CAS\u0027: \u00277647-01-0\u0027, \u0027density\u0027: [0.0002838722604829, 0.0039494695716988, 2.85020047681807, -0.0157747012568046, -3766.20868665006], \u0027viscosity\u0027: [10.3259686042518, 1.71378270014506, 1.48613181961032, 0.0012790744923139, 23.7644188926256, 2.1827423115052], \u0027density_range\u0027: [5.0, 98.8200000000001, 0.375698567711746], \u0027viscosity_range\u0027: [10.0, 42.5, 0.36]}, \u0027Ammonia\u0027: {\u0027CAS\u0027: \u00277664-41-7\u0027, \u0027density\u0027: [0.0637631725924523, 0.0681799828976475, 1.23759952767397, -0.0059985249372147, -3078.57767189507], \u0027viscosity\u0027: [214.093149693271, 8.02413293476943, 6.62645825743232, 0.0057942959530428, 255.273038265555, 0.243086396113273], \u0027density_range\u0027: [20.0, 140.65, 0.521892056235873], \u0027viscosity_range\u0027: [19.85, 39.85, 0.339554069991558]}, \u0027Ammonium Chloride\u0027: {\u0027CAS\u0027: \u002712125-02-9\u0027, \u0027density\u0027: [16.8882196383907, 318.560293047784, 5.08655606958672, -0.0150616503055142, -1769.12237165588], \u0027viscosity\u0027: [12.3958070582055, 1.50390805858088, -1.77559495076665, 0.234706870177963, -2.75914543946026, 2.84081895215159], \u0027density_range\u0027: [12.5, 100.0, 0.4], \u0027viscosity_range\u0027: [10.0, 73.5, 0.324324324324324]}}\n\u0022\u0022\u0022Isothermal aqueous analytical-component properties (Python 2/3 compatible).\n\nLaliberte 2009, doi:10.1021/je8008123. PARAMS is injected into native scripts.\nNo acid speciation, VLE, retention, or mixing-enthalpy model is implied.\n\u0022\u0022\u0022\nfrom math import exp,log,pi,sqrt\nCOMPONENTS=[\u0027Water\u0027,\u0027Nitric acid\u0027,\u0027Hydrogen chloride\u0027,\u0027Ammonia\u0027,\u0027Ammonium Chloride\u0027]\nMW=[18.01528,63.01284,36.46094,17.03052,53.49146] # g/mol; last = HCl + NH3\n\ndef liquid_density(masses,T=298.15):\n    total=sum(masses)\n    if total\u003c=0: raise ValueError(\u0027A liquid stream needs positive mass\u0027)\n    w=[x/total for x in masses]; ww=w[0]; t=T-273.15\n    rho_w=(((((-2.8054253e-10*t+1.0556302e-7)*t-4.6170461e-5)*t-.0079870401)*t+16.945176)*t+999.83952)/(1+.01687985*t)\n    invrho=ww/rho_w\n    for i,name in enumerate(COMPONENTS[1:],1):\n        if w[i]\u003c=0:continue\n        p=PARAMS[name]; low,high,wmax=p[\u0027density_range\u0027]\n        if t\u003clow-1e-8 or t\u003ehigh+1e-8 or w[i]\u003ewmax+1e-8:raise ValueError(\u0027Density correlation outside domain: \u0027+name)\n        c0,c1,c2,c3,c4=p[\u0027density\u0027]\n        rho=((c0*(1-ww)+c1)*exp(1e-6*(t+c4)**2))/((1-ww)+c2+c3*t)\n        invrho+=w[i]/rho\n    return 1/invrho\n\ndef liquid_viscosity(masses,T=298.15):\n    total=sum(masses);w=[x/total for x in masses];ww=w[0];t=T-273.15\n    mu_w=(t+246)/((.05594*t+5.2842)*t+137.37) # mPa s\n    log_mu=ww*log(mu_w)\n    for i,name in enumerate(COMPONENTS[1:],1):\n        if w[i]\u003c=0:continue\n        p=PARAMS[name];low,high,wmax=p[\u0027viscosity_range\u0027]\n        if t\u003clow-1e-8 or t\u003ehigh+1e-8 or w[i]\u003ewmax+1e-8:raise ValueError(\u0027Viscosity correlation outside domain: \u0027+name)\n        v1,v2,v3,v4,v5,v6=p[\u0027viscosity\u0027]\n        # Evaluate logarithm directly; pure-water branch avoids negative powers at zero.\n        log_mu+=w[i]*((v1*(1-ww)**v2+v3)/(v4*t+1)-log(v5*(1-ww)**v6+1))\n    return exp(log_mu)*1e-3\n\ndef liquid_volume(masses):\n    return sum(masses)/liquid_density(masses)*1e6 # kg / kg m-3 -\u003e mL\n\ndef solution(volume_mL, concentrations=None):\n    \u0022\u0022\u0022Masses kg from final solution volume and analytical molarities at 25 C.\u0022\u0022\u0022\n    if concentrations is None: concentrations={}\n    masses=[0.0]*5\n    for name,C in concentrations.items():\n        i=COMPONENTS.index(name);masses[i]=C*volume_mL/1000*MW[i]/1000\n    solute=sum(masses)\n    # Bracket water mass inside each binary correlation\u0027s domain.\n    min_water=1e-12\n    for i,name in enumerate(COMPONENTS[1:],1):\n        if masses[i]\u003e0:min_water=max(min_water,masses[i]/PARAMS[name][\u0027density_range\u0027][2]-solute)\n    lo=max(min_water,1e-12);hi=max(volume_mL*.002,lo*2)\n    masses[0]=lo\n    if liquid_volume(masses)\u003evolume_mL+1e-8:raise ValueError(\u0027Requested concentration exceeds validated domain\u0027)\n    for k in range(80):\n        masses[0]=(lo+hi)/2\n        if liquid_volume(masses)\u003evolume_mL:hi=masses[0]\n        else:lo=masses[0]\n    masses[0]=(lo+hi)/2\n    return masses\n\ndef mix_mass(*vectors):\n    return [sum(v[i] for v in vectors) for i in range(5)]\n\ndef subtract_mass(a,b):\n    out=[a[i]-b[i] for i in range(5)]\n    if min(out)\u003c-1e-12:raise ValueError(\u0027Specified collection cut exceeds available component mass\u0027)\n    return [max(0,x) for x in out]\n\ndef condition(feed,target_M=.05,base_M=1.):\n    \u0022\u0022\u0022Scenario NH3(aq) addition to analytical free-HCl target; no pH prediction.\u0022\u0022\u0022\n    acid=feed[2]/(MW[2]/1000)\n    if feed[1]\u003e1e-12 or feed[3]\u003e1e-12:raise ValueError(\u0027Conditioner boundary assumes HCl carryover only\u0027)\n    def at(v):\n        base=solution(v,{\u0027Ammonia\u0027:base_M}) if v\u003e0 else [0.]*5\n        out=mix_mass(feed,base)\n        n=min(acid,base[3]/(MW[3]/1000))\n        out[2]-=n*MW[2]/1000;out[3]-=n*MW[3]/1000\n        out[4]+=n*(MW[2]+MW[3])/1000\n        return base,out,(acid-n)/(liquid_volume(out)/1000)\n    lo=0.;hi=acid/base_M*1000\n    if at(0)[2]\u003ctarget_M-1e-10:raise ValueError(\u0027Initial acid below specified target\u0027)\n    for k in range(65):\n        mid=(lo+hi)/2\n        if at(mid)[2]\u003etarget_M:lo=mid\n        else:hi=mid\n    base,out,c=at((lo+hi)/2)\n    return base,out,c\n\ndef ergun(masses,flow_mL_min,bed_mL,diameter_mm,particle_um=100.,voidage=.4):\n    \u0022\u0022\u0022Clean spherical fixed-bed screening; no resin compression/dispersion claim.\u0022\u0022\u0022\n    rho=liquid_density(masses);mu=liquid_viscosity(masses)\n    area=pi*(diameter_mm*.001)**2/4\n    length=bed_mL*1e-6/area;u=flow_mL_min*1e-6/60/area;dp=particle_um*1e-6;e=voidage\n    dP=length*(150*mu*(1-e)**2*u/(e**3*dp**2)+1.75*rho*(1-e)*u*u/(e**3*dp))\n    return dP\n\ndef ph_recovery(ph):\n    if ph\u003c1.5 or ph\u003e2.5:raise ValueError(\u0027Measured pH interpolation restricted to 1.5--2.5\u0027)\n    if ph\u003c=2:return .95+.06*(ph-1.5)\n    return .98-.64*(ph-2)\n\npropval=liquid_density([float(matstr.Phases[0].Compounds[n].MassFraction) for n in COMPONENTS],float(matstr.GetTemperature()))\n"
