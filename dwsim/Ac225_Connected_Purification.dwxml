      <ScriptText>PARAMS = {'Nitric acid': {'CAS': '7697-37-2', 'density': [0.272070788161643, -0.399605969016834, -2.33691977745914, 0.0066211238427596, -3089.01794099058], 'viscosity': [8.22640393251e-05, -1.39718811419252, 0.11961884204502, -0.0199197916008091, -1.44481163970687, 0.906940098315068], 'density_range': [-10.0, 95.0, 0.7011], 'viscosity_range': [4.0, 25.0, 0.308600425720215]}, 'Hydrogen chloride': {'CAS': '7647-01-0', 'density': [0.0002838722604829, 0.0039494695716988, 2.85020047681807, -0.0157747012568046, -3766.20868665006], 'viscosity': [10.3259686042518, 1.71378270014506, 1.48613181961032, 0.0012790744923139, 23.7644188926256, 2.1827423115052], 'density_range': [5.0, 98.8200000000001, 0.375698567711746], 'viscosity_range': [10.0, 42.5, 0.36]}, 'Ammonia': {'CAS': '7664-41-7', 'density': [0.0637631725924523, 0.0681799828976475, 1.23759952767397, -0.0059985249372147, -3078.57767189507], 'viscosity': [214.093149693271, 8.02413293476943, 6.62645825743232, 0.0057942959530428, 255.273038265555, 0.243086396113273], 'density_range': [20.0, 140.65, 0.521892056235873], 'viscosity_range': [19.85, 39.85, 0.339554069991558]}, 'Ammonium Chloride': {'CAS': '12125-02-9', 'density': [16.8882196383907, 318.560293047784, 5.08655606958672, -0.0150616503055142, -1769.12237165588], 'viscosity': [12.3958070582055, 1.50390805858088, -1.77559495076665, 0.234706870177963, -2.75914543946026, 2.84081895215159], 'density_range': [12.5, 100.0, 0.4], 'viscosity_range': [10.0, 73.5, 0.324324324324324]}}
"""Isothermal aqueous analytical-component properties (Python 2/3 compatible).

Laliberte 2009, doi:10.1021/je8008123. PARAMS is injected into native scripts.
No acid speciation, VLE, retention, or mixing-enthalpy model is implied.
"""
from math import exp,log,pi,sqrt
COMPONENTS=['Water','Nitric acid','Hydrogen chloride','Ammonia','Ammonium Chloride']
MW=[18.01528,63.01284,36.46094,17.03052,53.49146] # g/mol; last = HCl + NH3

def liquid_density(masses,T=298.15):
    total=sum(masses)
    if total&lt;=0: raise ValueError('A liquid stream needs positive mass')
    w=[x/total for x in masses]; ww=w[0]; t=T-273.15
    rho_w=(((((-2.8054253e-10*t+1.0556302e-7)*t-4.6170461e-5)*t-.0079870401)*t+16.945176)*t+999.83952)/(1+.01687985*t)
    invrho=ww/rho_w
    for i,name in enumerate(COMPONENTS[1:],1):
        if w[i]&lt;=0:continue
        p=PARAMS[name]; low,high,wmax=p['density_range']
        if t&lt;low-1e-8 or t&gt;high+1e-8 or w[i]&gt;wmax+1e-8:raise ValueError('Density correlation outside domain: '+name)
        c0,c1,c2,c3,c4=p['density']
        rho=((c0*(1-ww)+c1)*exp(1e-6*(t+c4)**2))/((1-ww)+c2+c3*t)
        invrho+=w[i]/rho
    return 1/invrho

def liquid_viscosity(masses,T=298.15):
    total=sum(masses);w=[x/total for x in masses];ww=w[0];t=T-273.15
    mu_w=(t+246)/((.05594*t+5.2842)*t+137.37) # mPa s
    log_mu=ww*log(mu_w)
    for i,name in enumerate(COMPONENTS[1:],1):
        if w[i]&lt;=0:continue
        p=PARAMS[name];low,high,wmax=p['viscosity_range']
        if t&lt;low-1e-8 or t&gt;high+1e-8 or w[i]&gt;wmax+1e-8:raise ValueError('Viscosity correlation outside domain: '+name)
        v1,v2,v3,v4,v5,v6=p['viscosity']
        # Evaluate logarithm directly; pure-water branch avoids negative powers at zero.
        log_mu+=w[i]*((v1*(1-ww)**v2+v3)/(v4*t+1)-log(v5*(1-ww)**v6+1))
    return exp(log_mu)*1e-3

def liquid_volume(masses):
    return sum(masses)/liquid_density(masses)*1e6 # kg / kg m-3 -&gt; mL

def solution(volume_mL, concentrations=None):
    """Masses kg from final solution volume and analytical molarities at 25 C."""
    if concentrations is None: concentrations={}
    masses=[0.0]*5
    for name,C in concentrations.items():
        i=COMPONENTS.index(name);masses[i]=C*volume_mL/1000*MW[i]/1000
    solute=sum(masses)
    # Bracket water mass inside each binary correlation's domain.
    min_water=1e-12
    for i,name in enumerate(COMPONENTS[1:],1):
        if masses[i]&gt;0:min_water=max(min_water,masses[i]/PARAMS[name]['density_range'][2]-solute)
    lo=max(min_water,1e-12);hi=max(volume_mL*.002,lo*2)
    masses[0]=lo
    if liquid_volume(masses)&gt;volume_mL+1e-8:raise ValueError('Requested concentration exceeds validated domain')
    for k in range(80):
        masses[0]=(lo+hi)/2
        if liquid_volume(masses)&gt;volume_mL:hi=masses[0]
        else:lo=masses[0]
    masses[0]=(lo+hi)/2
    return masses

def mix_mass(*vectors):
    return [sum(v[i] for v in vectors) for i in range(5)]

def subtract_mass(a,b):
    out=[a[i]-b[i] for i in range(5)]
    if min(out)&lt;-1e-12:raise ValueError('Specified collection cut exceeds available component mass')
    return [max(0,x) for x in out]

def condition(feed,target_M=.05,base_M=1.):
    """Scenario NH3(aq) addition to analytical free-HCl target; no pH prediction."""
    acid=feed[2]/(MW[2]/1000)
    if feed[1]&gt;1e-12 or feed[3]&gt;1e-12:raise ValueError('Conditioner boundary assumes HCl carryover only')
    def at(v):
        base=solution(v,{'Ammonia':base_M}) if v&gt;0 else [0.]*5
        out=mix_mass(feed,base)
        n=min(acid,base[3]/(MW[3]/1000))
        out[2]-=n*MW[2]/1000;out[3]-=n*MW[3]/1000
        out[4]+=n*(MW[2]+MW[3])/1000
        return base,out,(acid-n)/(liquid_volume(out)/1000)
    lo=0.;hi=acid/base_M*1000
    if at(0)[2]&lt;target_M-1e-10:raise ValueError('Initial acid below specified target')
    for k in range(65):
        mid=(lo+hi)/2
        if at(mid)[2]&gt;target_M:lo=mid
        else:hi=mid
    base,out,c=at((lo+hi)/2)
    return base,out,c

def ergun(masses,flow_mL_min,bed_mL,diameter_mm,particle_um=100.,voidage=.4):
    """Clean spherical fixed-bed screening; no resin compression/dispersion claim."""
    rho=liquid_density(masses);mu=liquid_viscosity(masses)
    area=pi*(diameter_mm*.001)**2/4
    length=bed_mL*1e-6/area;u=flow_mL_min*1e-6/60/area;dp=particle_um*1e-6;e=voidage
    dP=length*(150*mu*(1-e)**2*u/(e**3*dp**2)+1.75*rho*(1-e)*u*u/(e**3*dp))
    return dP

def ph_recovery(ph):
    if ph&lt;1.5 or ph&gt;2.5:raise ValueError('Measured pH interpolation restricted to 1.5--2.5')
    if ph&lt;=2:return .95+.06*(ph-1.5)
    return .98-.64*(ph-2)

# Native IronPython CustomUO body. liquid_properties.py and PARAMS precede this code.
from System import Array,Double
from math import exp,log

_basis=3600.0
_keys=['A225_Bq','A226_Bq','A227_Bq','Ra225_Bq']
_lam=[log(2)/9.92,log(2)/1.224,log(2)/(21.7*365.25),log(2)/14.9]
_p=Me.InputVariables
_result={}
def get_mass(s):
    rate=s.GetMassFlow()
    return [float(s.Phases[0].Compounds[n].MassFraction)*rate*_basis for n in COMPONENTS]
def get_iso(s):
    return [float(s.GetExtraPropertyValue(k) or 0.0) for k in _keys]
def get_age(s):return float(s.GetExtraPropertyValue('age_d') or 0.0)
def put(s,m,A,age):
    s.SetTemperature(298.15);s.SetPressure(101325.0)
    s.SetOverallMassComposition(Array[Double]([v/sum(m) for v in m]))
    s.SetMassFlow(sum(m)/_basis)
    for k,v in zip(_keys,A):s.SetExtraPropertyValue(k,float(v))
    s.SetExtraPropertyValue('age_d',float(age))
    s.SetExtraPropertyValue('batch_basis_s',_basis)
    s.SetExtraPropertyValue('batch_volume_mL',liquid_volume(m))
def decay(A,minutes):
    td=minutes/1440.
    out=[A[i]*exp(-_lam[i]*td) for i in range(4)]
    out[0]+=A[3]*_lam[0]/(_lam[0]-_lam[3])*(exp(-_lam[3]*td)-exp(-_lam[0]*td))
    return out
def close(inmass,outmass,Ain,Aout):
    _result['total_mass_residual_kg']=sum(inmass)-sum(outmass)
    _result['heavy_descendant_sink_atoms']=sum(Ain[i]/(_lam[i]/86400.)-Aout[i]/(_lam[i]/86400.) for i in range(4))

_kind=int(_p['kind'])
if _kind==0: # source boundary: primary fraction is an input to this subflowsheet
    _age=_p['cooling_d']+5./24
    _A=[1e6,1e6*_p['r226'],1e6*_p['r227'],0.]
    _A=decay(_A,_age*1440.)
    _A=[_A[i]*_p['eta_primary'] if i&lt;3 else 0. for i in range(4)]
    put(oms1,solution(80.,{'Nitric acid':10.}),_A,_age)
    _result['primary_duration_h']=5.
elif _kind==1: # isothermal conditioning mixer
    _m1=get_mass(ims1);_m2=get_mass(ims2);_m=mix_mass(_m1,_m2)
    _A0=get_iso(ims1);_dt=_p['duration_min'];_A=decay(_A0,_dt)
    put(oms1,_m,_A,get_age(ims1)+_dt/1440.)
    _result['mixed_volume_mL']=liquid_volume(_m)
    _result['analytical_HNO3_M']=_m[1]/(MW[1]/1000)/(liquid_volume(_m)/1000.)
    close(mix_mass(_m1,_m2),_m,_A0,_A)
elif _kind in [2,4]: # sequential batch-column collection/raffinate ledger
    _ss=[ims1,ims2,ims3,ims4];_mm=[get_mass(s) for s in _ss]
    _mi=mix_mass(*_mm)
    _pumped=sum(liquid_volume(m) for m in _mm)
    _dt=_pumped/_p['flow_mL_min']
    _cut=solution(10.,{'Hydrogen chloride':_p['carry_HCl_M']}) if _kind==2 else solution(10.,{'Nitric acid':.7})
    _waste=subtract_mass(_mi,_cut)
    _A0=get_iso(ims1);_aged=decay(_A0,_dt)
    _prod=[v*_p['eta_Ac'] if i&lt;3 else 0. for i,v in enumerate(_aged)]
    _lost=[_aged[i]-_prod[i] for i in range(4)]
    _age=get_age(ims1)+_dt/1440.
    put(oms1,_cut,_prod,_age);put(oms2,_waste,_lost,_age)
    _result['pumped_volume_mL']=_pumped
    _result['max_pressure_drop_Pa']=max(ergun(m,_p['flow_mL_min'],_p['bed_mL'],_p['diameter_mm'],_p['particle_um'],_p['voidage']) for m in _mm)
    _result['max_pressure_drop_upper_Pa']=max(ergun(m,_p['flow_mL_min'],_p['bed_mL'],_p['diameter_mm'],50.,.35) for m in _mm)
    _result['component_mass_max_residual_kg']=max(abs(_mi[i]-_cut[i]-_waste[i]) for i in range(5))
    close(_mi,mix_mass(_cut,_waste),_A0,_aged)
elif _kind==3: # specified NH3 addition, stoichiometric analytical neutralization
    _f=get_mass(ims1);_b=get_mass(ims2);_m=mix_mass(_f,_b)
    _n=min(_m[2]/(MW[2]/1000),_m[3]/(MW[3]/1000))
    _m[2]-=_n*MW[2]/1000;_m[3]-=_n*MW[3]/1000;_m[4]+=_n*(MW[2]+MW[3])/1000
    _dt=_p['duration_min'];_A0=get_iso(ims1);_A=decay(_A0,_dt)
    put(oms1,_m,_A,get_age(ims1)+_dt/1440.)
    _result['analytical_free_HCl_M']=_m[2]/(MW[2]/1000)/(liquid_volume(_m)/1000)
    _result['NH3_consumed_mol']=_n
    close(mix_mass(_f,_b),_m,_A0,_A)
elif _kind==5: # explicit protocol allowance and additional queue
    _m=get_mass(ims1);_A0=get_iso(ims1);_dt=_p['protocol_allowance_min']+60*_p['extra_queue_h']
    _A=decay(_A0,_dt);put(oms1,_m,_A,get_age(ims1)+_dt/1440.)
    _result['activity_concentration_Bq_mL']=_A[0]/liquid_volume(_m)
    close(_m,_m,_A0,_A)
elif _kind==6: # separate literature-matrix evidence, not a fitted Tan column
    _result['Ac_recovery']=ph_recovery(_p['load_pH'])
    _result['worst_recovery_in_control_interval']=min(ph_recovery(_p['load_pH']-_p['pH_halfwidth']),ph_recovery(_p['load_pH']+_p['pH_halfwidth']))

if _kind not in [0,6]:_result['duration_min']=_dt
for _name,_value in _result.items():globals()[str(_name)]=float(_value)
