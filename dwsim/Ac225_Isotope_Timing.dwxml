        <Item Key="A227_delivery_Bq" Value="2858.49807103926" />
        <Item Key="A225_delivery_per_reference" Value="0.239120271955188" />
        <Item Key="R226_delivery" Value="0.00634665898892972" />
        <Item Key="R227_delivery" Value="0.0119542272500215" />
        <Item Key="P_Ac_delivery" Value="0.982028016977826" />
