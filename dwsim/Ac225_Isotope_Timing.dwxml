        <Item Key="R226_delivery" Value="0.0119455243205535" />
        <Item Key="R227_delivery" Value="0.00430352181000775" />
        <Item Key="P_Ac_delivery" Value="0.984010763707547" />
        <Item Key="parent_Ac_gain_factor" Value="1" />
        <Item Key="parent_free_best_purity_age_d" Value="19.2682188280375" />
        <Item Key="parent_free_max_P_Ac" Value="0.992960382820998" />
        <Item Key="parent_free_individual_lower_age_d" Value="14.3581050401892" />
        <Item Key="parent_free_individual_upper_age_d" Value="26.0819119074819" />
        <Item Key="parent_free_individual_window_exists" Value="1" />
        <Item Key="parent_free_P_Ac_window_exists" Value="1" />
        <Item Key="parent_free_P_Ac_lower_age_d" Value="15.6472106068354" />
        <Item Key="parent_free_P_Ac_upper_age_d" Value="26.1858896281655" />
        <Item Key="parent_free_start_window_lower_d" Value="12.6472106068354" />
        <Item Key="parent_free_start_window_upper_d" Value="21.1858896281655" />
        <Item Key="parent_free_start_window_exists" Value="1" />
        <Item Key="parent_free_earliest_start_worst_A225_per_reference" Value="0.176060772367136" />
        <Item Key="relative_gain_if_9h_saved" Value="0.0265489476815832" />
        <Item Key="parent_free_critical_r227_for_individual_limits" Value="0.00367145014787131" />
